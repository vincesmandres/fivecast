# Optional environment overrides. No credentials are needed or supported.
# This file is documentation only; FiveCast does not automatically load dotenv files.
FIVECAST_DB_PATH=data/fivecast.db
FIVECAST_INTERVAL_SECONDS=5
FIVECAST_REQUEST_TIMEOUT_SECONDS=10
FIVECAST_MAX_QUOTE_AGE_SECONDS=30
FIVECAST_MAX_QUOTE_SKEW_SECONDS=10
FIVECAST_RETRY_ATTEMPTS=3
FIVECAST_RETRY_BACKOFF_SECONDS=1
FIVECAST_RETRY_MAX_BACKOFF_SECONDS=30
FIVECAST_SETTLEMENT_POLL_INTERVAL_SECONDS=30
FIVECAST_LOG_LEVEL=INFO
